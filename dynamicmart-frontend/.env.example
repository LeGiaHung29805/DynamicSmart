# Recommended locally and required when exposing the frontend through ngrok:
# calls from the browser use /api/... and Next.js proxies them to the Gateway.
NEXT_PUBLIC_API_BASE_URL=same-origin
# URL reachable from the Next.js server, never the public ngrok URL.
API_GATEWAY_INTERNAL_URL=http://localhost:8080
# Development tunnel hostname only (no https:// or port). Required for Next.js
# 16 to accept dev resources and router updates through ngrok.
# NEXT_DEV_TUNNEL_HOST=your-subdomain.ngrok-free.dev
# Set only when the browser can directly reach a second Gateway instance.
# NEXT_PUBLIC_API_FALLBACK_URL=http://localhost:28080

# Chỉ bật khi demo catalog-service độc lập; môi trường tích hợp để false.
NEXT_PUBLIC_CATALOG_STANDALONE_DEMO=false
