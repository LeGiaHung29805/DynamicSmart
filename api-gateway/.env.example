#Tạo file .env để gateway được tới các cổng
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Route đến business service; Gateway không có DB/Flyway/RabbitMQ.
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
CART_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
ENGAGEMENT_SERVICE_URL=http://localhost:8086

# Khóa mẫu chỉ dùng local/dev; đổi khóa riêng khi triển khai thật.
JWT_ISSUER=dynamicmart-identity-service
# Phải cùng JWT_HMAC_SECRET_BASE64 với identity-service ở cùng môi trường.
