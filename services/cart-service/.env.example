# Tạo file .env để đặt mật khẩu tài khoản cho postgreSQL
SPRING_PROFILES_ACTIVE=local

# cart_db — gồm Cart, Direct Sale và Voucher.
DB_URL=jdbc:postgresql://localhost:5432/cart_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

# Catalog dùng để kiểm tra Variant/giá niêm yết qua contract nội bộ.
CATALOG_SERVICE_BASE_URL=http://localhost:8082
