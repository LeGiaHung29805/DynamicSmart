# Tạo file .env để đặt mật khẩu tài khoản cho postgreSQL
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8083

# cart_db — gồm Cart, Direct Sale và Voucher.
DB_URL=jdbc:postgresql://localhost:5432/cart_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

# Catalog dùng để kiểm tra Variant/giá niêm yết qua contract nội bộ.
CATALOG_SERVICE_BASE_URL=http://localhost:8082
IDENTITY_SERVICE_BASE_URL=http://localhost:8081
PAYMENT_SERVICE_BASE_URL=http://localhost:8085

# Phải giống Identity Service và API Gateway trong cùng môi trường.
JWT_ISSUER=dynamicmart-identity-service
JWT_HMAC_SECRET_BASE64=replace_with_base64_secret_of_at_least_32_bytes

# Dùng cho contract nội bộ từ Order Service; tối thiểu 24 ký tự và không commit giá trị thật.
INTERNAL_API_KEY=replace-with-at-least-24-characters
