# Local-only secrets belong in .env; this file is safe to commit.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8085

DB_URL=jdbc:postgresql://localhost:5432/payment_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
INTERNAL_API_KEY=generate_a_new_shared_service_secret

VNPAY_TMN_CODE=replace_with_vnpay_tmn_code
VNPAY_HASH_SECRET=replace_with_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/payment/result

ZALOPAY_APP_ID=replace_with_zalopay_app_id
ZALOPAY_KEY1=replace_with_zalopay_key1
ZALOPAY_KEY2=replace_with_zalopay_key2
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://your-public-gateway.example/api/v1/payments/zalopay/callback
ZALOPAY_RETURN_URL=http://localhost:3000/checkout/payment/result

PAYOS_CLIENT_ID=replace_with_payos_client_id
PAYOS_API_KEY=replace_with_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_payos_checksum_key
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/checkout/payment/result
PAYOS_CANCEL_URL=http://localhost:3000/checkout/payment/result

SEPAY_WEBHOOK_SECRET=replace_with_sepay_webhook_secret
PAYMENT_QR_BANK_ID=MB
PAYMENT_QR_ACCOUNT_NO=replace_with_bank_account
PAYMENT_QR_ACCOUNT_NAME=replace_with_account_name
PAYMENT_QR_BASE_URL=https://vietqr.app/img

GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=replace_with_ghn_token
GHN_SHOP_ID=replace_with_ghn_shop_id
GHN_FROM_DISTRICT_ID=1482
GHN_FROM_WARD_CODE=11007
GHN_QUOTE_TTL_MINUTES=15
