# Tạo file .env để đặt cấu hình local; tuyệt đối không commit secret thật.
SPRING_PROFILES_ACTIVE=local

# payment_db — gồm Payment, callback VNPay và danh mục địa giới GHN.
DB_URL=jdbc:postgresql://localhost:5432/payment_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

# Shared only between internal services; do not expose to browser.
INTERNAL_API_KEY=replace_with_internal_api_key

# VNPay Sandbox
VNPAY_TMN_CODE=replace_with_vnpay_tmn_code
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/payment/result
VNPAY_HASH_SECRET=replace_with_vnpay_hash_secret

# GHN. The fixed sender warehouse remains server-side.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=replace_with_ghn_token
GHN_SHOP_ID=replace_with_ghn_shop_id
# GHN fee API needs the sender district. Keep province/ward below for deployment metadata too.
GHN_FROM_DISTRICT_ID=replace_with_warehouse_district_id
GHN_FROM_PROVINCE_ID=replace_with_warehouse_province_id
GHN_FROM_WARD_ID=replace_with_warehouse_ward_id
GHN_QUOTE_TTL_MINUTES=15
