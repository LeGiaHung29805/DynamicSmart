# IntelliJ: copy các biến này vào Run Configuration > Environment variables.
SPRING_PROFILES_ACTIVE=local

# catalog_db
DB_URL=jdbc:postgresql://localhost:5432/catalog_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# RabbitMQ / Spring Cloud Stream — thêm binder và binding trước khi dùng event thật.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

# Promotion Engine của Cart Service: chỉ dùng API/service discovery, không đọc cart_db.
CART_SERVICE_BASE_URL=http://localhost:8083
