# IntelliJ: copy các biến này vào Run Configuration > Environment variables.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082

# catalog_db
DB_URL=jdbc:postgresql://localhost:5432/catalog_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# Phải giống Identity Service và API Gateway trong cùng môi trường.
JWT_ISSUER=dynamicmart-identity-service
JWT_HMAC_SECRET_BASE64=replace_with_base64_secret_of_at_least_32_bytes

# Chỉ Order/Cart Service được biết giá trị này; browser không được nhận.
INTERNAL_API_KEY=replace_with_internal_service_key
INVENTORY_EXPIRATION_SCAN_MS=30000
OUTBOX_PUBLISHER_DELAY_MS=1000
OUTBOX_ENABLED=true

# RabbitMQ / Spring Cloud Stream — binder và binding catalog.events đã được cấu hình.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

# Promotion Engine của Cart Service: chỉ dùng API/service discovery, không đọc cart_db.
CART_SERVICE_BASE_URL=http://localhost:8083
CART_SERVICE_CONNECT_TIMEOUT_MS=1000
CART_SERVICE_READ_TIMEOUT_MS=1500
CATALOG_PROMOTION_MODE=HTTP

# CORS khi frontend gọi thẳng Catalog trong chế độ demo độc lập.
FRONTEND_ORIGIN=http://localhost:3000

# Demo độc lập: dùng SPRING_PROFILES_ACTIVE=local,standalone-demo và không cần Rabbit/Cart/Identity.
CATALOG_DEMO_PASSWORD=Demo@123
CATALOG_DEMO_TOKEN_TTL_SECONDS=3600
CATALOG_DEMO_DISCOUNT_PERCENT=15
