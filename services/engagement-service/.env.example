# Tạo file .env để đặt mật khẩu tài khoản cho postgreSQL
SPRING_PROFILES_ACTIVE=local

# engagement_db — Review/Reporting P0; Wishlist, Q&A, Notification và Chat mở theo P1/P2.
DB_URL=jdbc:postgresql://localhost:5432/engagement_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

CATALOG_SERVICE_BASE_URL=http://localhost:8082
