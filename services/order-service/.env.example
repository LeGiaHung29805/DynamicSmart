# Copy thành .env để chạy local; không commit .env hoặc secret thật.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8084

# order_db — gồm Checkout Session, Order, snapshot và Saga.
DB_URL=jdbc:postgresql://localhost:5432/order_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password

IDENTITY_SERVICE_BASE_URL=http://localhost:8081
CATALOG_SERVICE_BASE_URL=http://localhost:8082
CART_SERVICE_BASE_URL=http://localhost:8083
PAYMENT_SERVICE_BASE_URL=http://localhost:8085

# Phải cùng issuer/secret với Identity Service và API Gateway.
JWT_ISSUER=dynamicmart-identity-service
JWT_HMAC_SECRET_BASE64=replace_with_shared_base64_secret

# Checkout Session là bản nháp, mặc định hết hạn sau 15 phút.
CHECKOUT_SESSION_TTL=15m

# Worker tiếp tục Saga bị gián đoạn. Lease phải dài hơn thời gian một lượt xử lý dự kiến.
ORDER_SAGA_RECOVERY_ENABLED=true
ORDER_SAGA_RECOVERY_FIXED_DELAY=30s
ORDER_SAGA_RECOVERY_INITIAL_DELAY=30s
ORDER_SAGA_RECOVERY_STALE_AFTER=30s
ORDER_SAGA_RECOVERY_LEASE_DURATION=2m
ORDER_SAGA_RECOVERY_RETRY_BACKOFF=1m
ORDER_SAGA_RECOVERY_BATCH_SIZE=20

# Outbox publisher. Lease bảo vệ một event khỏi bị nhiều instance gửi đồng thời.
ORDER_OUTBOX_PUBLISH_DELAY=1s
ORDER_OUTBOX_BATCH_SIZE=100
ORDER_OUTBOX_PROCESSING_LEASE=30s

# Timeout khi gọi đồng bộ sang service khác.
SERVICE_CONNECT_TIMEOUT=2s
SERVICE_READ_TIMEOUT=5s

# Khóa dùng cho các API nội bộ; phải thống nhất với service được gọi.
INTERNAL_API_KEY=replace_with_internal_api_key
