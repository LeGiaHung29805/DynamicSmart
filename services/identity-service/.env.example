#Tạo file .env để đặt mật khẩu tài khoản cho postgreSQL
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# identity_db
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# Authentication — thay bằng giá trị bí mật trong môi trường thật, không commit .env
JWT_ISSUER=dynamicmart-identity-service
# Khóa mẫu 32 bytes chỉ dùng local/dev; Identity và Gateway phải cùng giá trị. Đổi khóa riêng khi triển khai thật.
JWT_HMAC_SECRET_BASE64=CiYZjVClqyvwboeDW62WjNYyVrBx0rnxn1H5RqWOfCY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_COOKIE_SECURE=false
INTERNAL_API_KEY=replace-with-the-same-at-least-24-character-key
